; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TacticsGame"
run/main_scene="uid://nrsx7ey1xhyq"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GridManager="*res://scene/autoloads/grid_manager.tscn"
PlayerActionManager="*res://scene/autoloads/player_action_manager.tscn"
GameManager="*res://scene/autoloads/game_manager.tscn"
TurnManager="*res://scene/autoloads/turn_manager.tscn"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[input]

left_mouse_click={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/size/window_height_override=0
textures/size/window_width_override=0
textures/size/viewport_height=1280
textures/size/viewport_width=720
textures/stretch/scale=1.0
textures/stretch/scale_mode="fractional"
textures/stretch/aspect="keep"
textures/stretch/mode="viewport"
